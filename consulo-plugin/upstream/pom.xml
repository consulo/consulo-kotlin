<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>consulo.kotlin.plugin</groupId>
        <artifactId>consulo.kotlin.plugin.internal</artifactId>
        <version>3-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>consulo.kotlin.plugin.upstream</artifactId>
    <description>Upstream plugin sources (base/indices, base/analysis-api-platform, references, ...) compiled unchanged:
        the files that seeds.txt reaches, listed by consulo-plugin/tools/closure.py.</description>

    <properties>
        <plugin.root>${project.basedir}/../..</plugin.root>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>filter-src</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/filtered-sources/src</outputDirectory>
                            <resources>
                                <!-- closure:begin -->
                                <resource>
                                    <directory>${plugin.root}/base/analysis/src</directory>
                                    <includes>
                                        <include>org/jetbrains/kotlin/idea/caches/resolve/IDEPackagePartProvider.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/IdeStubIndexService.java</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/IndexUtils.kt</include>
                                        <include>org/jetbrains/kotlin/idea/util/resolveCalls.kt</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${plugin.root}/base/analysis-api-platform/src</directory>
                                    <includes>
                                        <include>org/jetbrains/kotlin/idea/base/analysisApiPlatform/IdeKotlinAnnotationsResolverFactory.kt</include>
                                        <include>org/jetbrains/kotlin/idea/base/analysisApiPlatform/IdeKotlinDeclarationProviderFactory.kt</include>
                                        <include>org/jetbrains/kotlin/idea/base/analysisApiPlatform/IdeKotlinModulePackageNamesProvider.kt</include>
                                        <include>org/jetbrains/kotlin/idea/base/analysisApiPlatform/IdeKotlinPackagePartProviderFactory.kt</include>
                                        <include>org/jetbrains/kotlin/idea/base/analysisApiPlatform/IdeKotlinPackageProviderFactory.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/impl/KaBaseArrayAccessReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/impl/KaBaseCollectionLiteralReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/impl/KaBaseConstructorDelegationReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/impl/KaBaseDefaultAnnotationArgumentReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/impl/KaBaseDestructuringDeclarationReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/impl/KaBaseForLoopInReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/impl/KaBaseInvokeFunctionReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/impl/KaBaseKDocReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/impl/KaBasePropertyDelegationMethodsReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/impl/KaBaseReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/impl/KaBaseReferenceResolver.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/impl/KaBaseSimpleNameReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/impl/KaSimpleNameReferenceBase.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/impl/ReadWriteAccessCheckerBaseImpl.kt</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${plugin.root}/base/fir/analysis-api-platform/src</directory>
                                    <includes>
                                        <include>org/jetbrains/kotlin/idea/base/fir/analysisApiPlatform/FirIdeKotlinModificationTrackerFactory.kt</include>
                                        <include>org/jetbrains/kotlin/idea/base/fir/analysisApiPlatform/FirIdeOutOfBlockModificationService.kt</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${plugin.root}/base/indices/src</directory>
                                    <includes>
                                        <include>org/jetbrains/kotlin/idea/base/indices/KotlinPackageIndexUtils.kt</include>
                                        <include>org/jetbrains/kotlin/idea/base/indices/metrics.kt</include>
                                        <include>org/jetbrains/kotlin/idea/base/indices/names/KotlinBinaryRootToPackageIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/base/indices/names/KotlinTopLevelCallableByPackageShortNameIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/base/indices/names/KotlinTopLevelClassLikeDeclarationByPackageShortNameIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/base/indices/names/NameByPackageShortNameIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/base/indices/names/internalUtils.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinAnnotationsIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinClassShortNameIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinExactPackagesIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinExtensionsByReceiverTypeStubIndexHelper.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinExtensionsInObjectsByReceiverTypeIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinFileFacadeClassByPackageIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinFileFacadeFqNameIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinFileFacadeShortNameIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinFullClassNameIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinFullTypeAliasNameIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinFunctionShortNameIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinJvmNameAnnotationIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinMultiFileClassPartIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinPrimeSymbolNameIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinProbablyInjectedFunctionShortNameIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinPropertyShortNameIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinScriptFqnIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinStringStubIndexHelper.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinSubclassObjectNameIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinSuperClassIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinTopLevelExpectFunctionFqNameIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinTopLevelExpectPropertyFqNameIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinTopLevelExtensionsByReceiverTypeIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinTopLevelFunctionFqnNameIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinTopLevelPropertyFqnNameIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinTypeAliasByExpansionShortNameIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/stubindex/KotlinTypeAliasShortNameIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/vfilefinder/KotlinBuiltInsMetadataIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/vfilefinder/KotlinJvmModuleAnnotationsIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/vfilefinder/KotlinMetadataFileIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/vfilefinder/KotlinMetadataFileIndexBase.kt</include>
                                        <include>org/jetbrains/kotlin/idea/vfilefinder/KotlinMetadataFilePackageIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/vfilefinder/KotlinModuleMappingIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/vfilefinder/KotlinPartialPackageNamesIndex.kt</include>
                                        <include>org/jetbrains/kotlin/idea/vfilefinder/KotlinStdlibIndex.kt</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${plugin.root}/base/project-structure/src</directory>
                                    <includes>
                                        <include>org/jetbrains/kotlin/idea/base/projectStructure/modules/KaSourceModuleForOutsider.kt</include>
                                        <include>org/jetbrains/kotlin/idea/vfilefinder/IdeVirtualFileFinder.kt</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${plugin.root}/base/psi/src</directory>
                                    <includes>
                                        <include>org/jetbrains/kotlin/idea/base/psi/JavaPsiUtils.kt</include>
                                        <include>org/jetbrains/kotlin/idea/base/psi/KotlinPsiHeuristics.kt</include>
                                        <include>org/jetbrains/kotlin/idea/base/psi/KotlinPsiUtils.kt</include>
                                        <include>org/jetbrains/kotlin/idea/base/psi/KotlinUserDataUtils.kt</include>
                                        <include>org/jetbrains/kotlin/idea/base/psi/PsiLinesUtils.kt</include>
                                        <include>org/jetbrains/kotlin/idea/base/psi/extensions/ImplementationDetailClassNameCheckerProvider.kt</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${plugin.root}/base/util/src</directory>
                                    <includes>
                                        <include>org/jetbrains/kotlin/caches/project/CacheUtils.kt</include>
                                        <include>org/jetbrains/kotlin/idea/base/util/KotlinScopeUtils.kt</include>
                                        <include>org/jetbrains/kotlin/util/CollectionUtils.kt</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${plugin.root}/references/src</directory>
                                    <includes>
                                        <include>org/jetbrains/kotlin/idea/references/AbstractKtReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KDocReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KtArrayAccessReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KtCollectionLiteralReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KtConstructorDelegationReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KtDefaultAnnotationArgumentReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KtDestructuringDeclarationReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KtForLoopInReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KtInvokeFunctionReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KtPropertyDelegationMethodsReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KtReferenceMutateService.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KtSimpleNameReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/ReadWriteAccessChecker.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/referenceUtil.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/referenceUtils.kt</include>
                                    </includes>
                                </resource>
                                <!-- closure:end -->
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <configuration>
                    <sourceDirs>
                        <sourceDir>${project.build.directory}/filtered-sources/src</sourceDir>
                    </sourceDirs>
                    <args combine.children="append">
                        <!-- upstream is built with positional destructuring (val (a, b) = pair) -->
                        <arg>-Xname-based-destructuring=only-syntax</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.psi.KtExperimentalApi</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.psi.KtNonPublicApi</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.psi.KtImplementationDetail</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.psi.KtIdeApi</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.psi.KtPlatformInterface</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.analysis.api.KaImplementationDetail</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.analysis.api.KaExperimentalApi</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.analysis.api.KaNonPublicApi</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.analysis.api.KaIdeApi</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.analysis.api.KaPlatformInterface</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.analysis.api.KaContextParameterApi</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.analysis.api.permissions.KaAllowProhibitedAnalyzeFromWriteAction</arg>
                    </args>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compileSourceRoots>
                        <compileSourceRoot>${project.build.directory}/filtered-sources/src</compileSourceRoot>
                    </compileSourceRoots>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>consulo.kotlin</groupId>
            <artifactId>consulo.kotlin.intellij-stubs</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- IntelliJ's Kotlin helper functions (runReadAction, parentOfType, ...), remapped with the compiler -->
        <dependency>
            <groupId>consulo.kotlin</groupId>
            <artifactId>consulo.kotlin.intellij-psi-extensions</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- data externalizers of the indexes -->
        <dependency>
            <groupId>consulo.kotlin</groupId>
            <artifactId>consulo.kotlin.build-common</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- class file decompiler: library stubs for the indexes -->
        <dependency>
            <groupId>consulo.kotlin</groupId>
            <artifactId>consulo.kotlin.analysis.decompiled.decompiler</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- the Analysis API with its compiler closure -->
        <dependency>
            <groupId>consulo.kotlin</groupId>
            <artifactId>consulo.kotlin.analysis.api-fir</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
