        <class name="org.jetbrains.kotlin.idea.formatter.KotlinLanguageCodeStyleSettingsProvider">
            <addMethod name="getConfigurableDisplayName" returnType="consulo.localize.LocalizeValue">
                <aload index="0"/>
                <invokevirtual owner="org.jetbrains.kotlin.idea.formatter.KotlinLanguageCodeStyleSettingsProvider" name="getConfigurableDisplayNameText" desc="()Ljava/lang/String;"/>
                <invokestatic owner="consulo.localize.LocalizeValue" name="of" desc="(Ljava/lang/String;)Lconsulo/localize/LocalizeValue;" itf="true"/>
                <areturn/>
            </addMethod>
        </class>
        <class name="org.jetbrains.kotlin.idea.formatter.KotlinSaveStylePanel">
            <addMethod name="getTabTitle" returnType="consulo.localize.LocalizeValue">
