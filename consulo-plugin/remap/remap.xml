<?xml version="1.0" encoding="UTF-8"?>
<!-- Plugin-specific rules, applied on top of the compiler port's remap.xml (consulo.kotlin.remapped:mapping).
     The <module> sections are merged; this file's name wins. -->
<remap>
    <classes>
        <!-- upstream classes in packages of the compiler jar (split packages), by consulo-plugin/tools/genservices.py -->
        <!-- genservices:splitpackages:begin -->
        <rule from="org.jetbrains.kotlin.util.AbstractKotlinBundle" to="org.jetbrains.kotlin.util.plugin.AbstractKotlinBundle"/>
        <rule from="org.jetbrains.kotlin.util.CollectionUtilsKt$cycle$1" to="org.jetbrains.kotlin.util.plugin.CollectionUtilsKt$cycle$1"/>
        <rule from="org.jetbrains.kotlin.util.CollectionUtilsKt$takeWhileInclusive$1" to="org.jetbrains.kotlin.util.plugin.CollectionUtilsKt$takeWhileInclusive$1"/>
        <rule from="org.jetbrains.kotlin.util.CollectionUtilsKt$takeWhileIsInstance$1" to="org.jetbrains.kotlin.util.plugin.CollectionUtilsKt$takeWhileIsInstance$1"/>
        <rule from="org.jetbrains.kotlin.util.CollectionUtilsKt" to="org.jetbrains.kotlin.util.plugin.CollectionUtilsKt"/>
        <rule from="org.jetbrains.kotlin.util.LightClassUtilsKt" to="org.jetbrains.kotlin.util.plugin.LightClassUtilsKt"/>
        <!-- genservices:splitpackages:end -->
        <!-- the plugin's only QuoteHandler is per language; Consulo registers those as LanguageQuoteHandler extensions -->
        <rule from="com.intellij.codeInsight.editorActions.QuoteHandler" to="consulo.language.editor.action.LanguageQuoteHandler"/>
    </classes>

    <redirects>
        <!-- inherited static SyntaxHighlighterBase.merge, compiled as a call on the subclass -->
        <method owner="org.jetbrains.kotlin.idea.highlighter.KotlinHighlighter" name="merge"
                desc="(Ljava/util/Map;Ljava/util/Map;)Ljava/util/Map;"
                target="consulo.kotlin.compat.editor.HighlighterCompat"/>
    </redirects>

    <modifications>
