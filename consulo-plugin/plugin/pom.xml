<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>consulo.kotlin.plugin</groupId>
        <artifactId>consulo.kotlin.plugin.internal</artifactId>
        <version>3-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>consulo.plugin</groupId>
    <artifactId>consulo.kotlin</artifactId>
    <packaging>consulo-plugin</packaging>

    <description>Consulo plugin descriptor and Consulo-native services. Packages the remapped compiler
        (consulo.kotlin.remapped) and plugin (consulo.kotlin.plugin.remapped) jars.</description>

    <build>
        <plugins>
            <!-- Same binding generation as consulo:arch.bind.java (@ServiceImpl/@ExtensionImpl -> *_Binding) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>consulo.internal</groupId>
                            <artifactId>compiler.apt.java</artifactId>
                            <version>${compiler.apt.version}</version>
                        </path>
                        <path>
                            <groupId>consulo.internal</groupId>
                            <artifactId>compiler.apt.java.generation</artifactId>
                            <version>${compiler.apt.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>consulo.maven</groupId>
                <artifactId>maven-consulo-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <!-- consulo.java and the plugins it requires, for the sandbox -->
                    <dependencies>
                        <dependency>consulo.java</dependency>
                        <dependency>com.intellij.xml</dependency>
                        <dependency>consulo.markdown</dependency>
                    </dependencies>
                    <packaging>
                        <skip>${dev.mode}</skip>
                        <version>${build.number}</version>
                    </packaging>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>consulo.internal</groupId>
                        <artifactId>compiler.apt.java.generation</artifactId>
                        <version>${compiler.apt.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <!-- as consulo:arch.bind.java: add generated bindings to module-info (provides InjectingBinding) -->
                    <execution>
                        <id>patch-module-info</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>patch-bind-module-info</goal>
                        </goals>
                    </execution>
                    <!-- KotlinIconGroup from src/main/resources/ICON-LIB (icons copied from upstream base/resources) -->
                    <execution>
                        <id>generate-icon</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate-icon</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>package</id>
                        <phase>package</phase>
                        <goals>
                            <goal>workspace</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- packaged into the plugin -->
        <dependency>
            <groupId>consulo.kotlin</groupId>
            <artifactId>consulo.kotlin.remapped</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>consulo.kotlin</groupId>
            <artifactId>consulo.kotlin.core.helper</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>consulo.kotlin.plugin</groupId>
            <artifactId>consulo.kotlin.plugin.remapped</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- runtime libraries of the Kotlin compiler, not provided by the platform -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.compiler.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-collections-immutable-jvm</artifactId>
            <version>0.5.1</version>
            <scope>compile</scope>
        </dependency>
        <!-- completion: its lookup objects and insertion handlers are @Serializable -->
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-serialization-core-jvm</artifactId>
            <version>1.11.0</version>
            <scope>compile</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.vavr</groupId>
            <artifactId>vavr</artifactId>
            <version>0.10.4</version>
            <scope>compile</scope>
        </dependency>
        <!-- Analysis API caches -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>2.9.3</version>
            <scope>compile</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- kotlin.script.dependencies / templates, used by script definitions -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-script-runtime</artifactId>
            <version>${kotlin.compiler.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>javax.inject</groupId>
            <artifactId>javax.inject</artifactId>
            <version>1</version>
            <scope>compile</scope>
        </dependency>

        <!-- platform -->
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-annotation</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-application-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo.plugin</groupId>
            <artifactId>consulo.java-java.language.api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-base-icon-library</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-ui-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-module-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-module-content-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-disposer-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-project-content-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-language-impl</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-component-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-language-editor-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-logging-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-document-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-application-content-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-language-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-virtual-file-system-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-localize-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
