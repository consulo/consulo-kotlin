<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>consulo.kotlin.plugin</groupId>
        <artifactId>consulo.kotlin.plugin.internal</artifactId>
        <version>3-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>consulo.plugin</groupId>
    <artifactId>consulo.kotlin</artifactId>
    <packaging>consulo-plugin</packaging>

    <description>Consulo plugin descriptor and Consulo-native services. Packages the remapped compiler
        (consulo.kotlin.remapped) and plugin (consulo.kotlin.plugin.remapped) jars.</description>

    <build>
        <plugins>
            <!-- Same binding generation as consulo:arch.bind.java (@ServiceImpl/@ExtensionImpl -> *_Binding) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>consulo.internal</groupId>
                            <artifactId>compiler.apt.java</artifactId>
                            <version>${compiler.apt.version}</version>
                        </path>
                        <path>
                            <groupId>consulo.internal</groupId>
                            <artifactId>compiler.apt.java.generation</artifactId>
                            <version>${compiler.apt.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>consulo.maven</groupId>
                <artifactId>maven-consulo-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <dependencies>
                        <dependency>consulo.java</dependency>
                    </dependencies>
                    <packaging>
                        <skip>${dev.mode}</skip>
                        <version>${build.number}</version>
                    </packaging>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>consulo.internal</groupId>
                        <artifactId>compiler.apt.java.generation</artifactId>
                        <version>${compiler.apt.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <!-- as consulo:arch.bind.java: add generated bindings to module-info (provides InjectingBinding) -->
                    <execution>
                        <id>patch-module-info</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>patch-bind-module-info</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>package</id>
                        <phase>package</phase>
                        <goals>
                            <goal>workspace</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- packaged into the plugin -->
        <dependency>
            <groupId>consulo.kotlin</groupId>
            <artifactId>consulo.kotlin.remapped</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>consulo.kotlin</groupId>
            <artifactId>consulo.kotlin.core.helper</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>consulo.kotlin.plugin</groupId>
            <artifactId>consulo.kotlin.plugin.remapped</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- platform -->
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-annotation</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-application-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-localize-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
